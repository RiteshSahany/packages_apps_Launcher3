<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_empty_recents_clover">
    
    <!-- Orbital Ring Animations -->
    <target
        android:name="outer_ring"
        android:animation="@animator/orbital_outer_rotation" />
    
    <target
        android:name="inner_ring"
        android:animation="@animator/orbital_inner_rotation" />
    
    <!-- Floating Card Animations -->
    <target
        android:name="card_1"
        android:animation="@animator/card_float_1" />
    
    <target
        android:name="card_2"
        android:animation="@animator/card_float_2" />
    
    <target
        android:name="card_3"
        android:animation="@animator/card_float_3" />
    
    <target
        android:name="card_4"
        android:animation="@animator/card_float_4" />
    
    <!-- Central Element Animation -->
    <target
        android:name="center_element"
        android:animation="@animator/center_pulse" />
    
    <!-- Particle Animations -->
    <target
        android:name="particle_1"
        android:animation="@animator/particle_float_1" />
    
    <target
        android:name="particle_2"
        android:animation="@animator/particle_float_2" />
    
    <target
        android:name="particle_3"
        android:animation="@animator/particle_float_3" />
    
    <target
        android:name="particle_4"
        android:animation="@animator/particle_float_4" />
</animated-vector>